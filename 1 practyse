import random


def generate_array(length, min_value, max_value):
    return [random.randint(min_value, max_value) for _ in range(length)]


def print_array(array):
    for i, value in enumerate(array):
        print(f"[елемент_{i}_значення_{value}]")

def even_count_and_sum(array, start_idx, end_idx):
 #1
    sub_array = array[start_idx:end_idx + 1]
    even_elements = [x for x in sub_array if x % 2 == 0]
    return len(even_elements), sum(even_elements)


def average_and_greater_count(array):
#2
    if not array:
        return 0, 0
    average = sum(array) / len(array)
    greater_count = sum(1 for x in array if x > average)
    return average, greater_count


def pairwise_sum(array1, array2):
 #3
    if len(array1) != len(array2):
        raise ValueError("Масиви повинні бути одинакової довжини!")
    return [a + b for a, b in zip(array1, array2)]


def concatenate_arrays(array1, array2):
#4
    return array1 + array2


def swap_min_max(array):
#5
    if not array:
        return []
    result = array.copy()
    min_index = result.index(min(result))
    max_index = result.index(max(result))

    result[min_index], result[max_index] = result[max_index], result[min_index]
    return result


def split_positive_negative(array):
#6
    positive = [x for x in array if x > 0]
    negative = [x for x in array if x < 0]
    return positive, negative


def remove_min_max_duplicates(array):
#7
    if not array:
        return []

    minimum = min(array)
    maximum = max(array)

    min_seen = False
    max_seen = False
    result = []

    for x in array:
        if x == minimum:
            if not min_seen:
                result.append(x)
                min_seen = True
        elif x == maximum:
            if not max_seen:
                result.append(x)
                max_seen = True
        else:
            result.append(x)

    return result


def elements_between_averages(array1, array2):
#8
    avg1 = sum(array1) / len(array1) if array1 else 0
    avg2 = sum(array2) / len(array2) if array2 else 0

    lower = min(avg1, avg2)
    upper = max(avg1, avg2)

    third_array = [x for x in (array1 + array2) if lower <= x <= upper]
    return avg1, avg2, third_array


class Inventory:
    def __init__(self, capacity=10):
        self.capacity = capacity
        self.slots = ["Empty"] * capacity

    def add_item(self, item):

        if "Empty" in self.slots:
            idx = self.slots.index("Empty")
            self.slots[idx] = item
            print(f" Предмет '{item}' додано в слот {idx}.")
            return True
        print(f" Не вдалося додати '{item}': інвентар повний!")
        return False

    def remove_item(self, item):

        if item in self.slots:
            idx = self.slots.index(item)
            self.slots[idx] = "Empty"
            print(f" Предмет '{item}' видалено зі слота {idx}.")
            return True
        print(f" Предмет '{item}' не знайдено.")
        return False

    def compact(self):
        items = [x for x in self.slots if x != "Empty"]
        self.slots = items + ["Empty"] * (self.capacity - len(items))
        print(" Інвентар ущільнено (порожні слоти переміщено в кінець).")

    def display(self):
        print(" Поточний стан інвентарю:", self.slots)




